rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidString(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidString(request.resource.data.name, 2, 100)
        && isValidString(request.resource.data.email, 5, 100);
      allow update: if isOwner(userId)
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
        && (!('isHealthProfessional' in request.resource.data) || request.resource.data.isHealthProfessional == resource.data.isHealthProfessional);
      // Account deletion must go through a Cloud Function (cascade cleanup of emergencies, FCM tokens etc.)
      allow delete: if false;
    }
    
    // Helper profiles — leitura direta fechada (R1).
    // Busca por proximidade é feita via Cloud Function getNearbyHelpers (Admin SDK).
    match /helpers/{helperId} {
      allow read: if isOwner(helperId);
      allow create, update: if isOwner(helperId)
        && request.resource.data.keys().hasOnly(['id','name','location','latitude','longitude','geohash','isActive','lastUpdate'])
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && (!('name' in request.resource.data) || isValidString(request.resource.data.name, 1, 100));
      allow delete: if isOwner(helperId);
    }
    
    // Emergency requests collection (coleção real usada pelo app).
    // Contém dado sensível (nome do solicitante + GPS exato) — list/get restritos a
    // participantes. Quem ainda não é participante (ex.: helper decidindo se aceita)
    // usa a projeção pública sem PII em /emergency_pings, mantida pela Cloud Function
    // onEmergencyRequestWrite. Ver /emergency_pings abaixo.
    match /emergency_requests/{emergencyId} {
      allow list: if isAuthenticated()
        && (resource.data.requesterId == request.auth.uid
            || resource.data.helperId == request.auth.uid);
      allow get: if isAuthenticated()
        && (request.auth.uid == resource.data.requesterId
            || request.auth.uid == resource.data.helperId);
      allow create: if isAuthenticated()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.active == true;
      allow update: if isAuthenticated()
        && (
          // Requester: cancel (active+status), severity, samuCalled/At, resolvedAt
          (request.auth.uid == resource.data.requesterId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'active', 'severity', 'samuCalled', 'samuCalledAt', 'resolvedAt']))
          // Helper atribuído: encerrar (status+active+resolvedAt)
          || (request.auth.uid == resource.data.helperId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'active', 'resolvedAt']))
          // Helper a aceitar: status waiting → matched, campos restritos
          || (resource.data.status == 'waiting'
              && resource.data.active == true
              && request.resource.data.helperId == request.auth.uid
              && request.resource.data.status == 'matched'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['helperId', 'helperName', 'status', 'matchedAt', 'expiresAt']))
        );
      allow delete: if false;
    }

    // Projeção pública (sem PII) de emergency_requests — mantida pela Cloud Function
    // onEmergencyRequestWrite (Admin SDK). Contém só o necessário para: (1) detectar
    // emergências ativas próximas antes de aceitar, e (2) a checagem inicial da
    // transação de aceite — nunca o nome do solicitante nem o GPS exato (arredondado
    // a ~111m, mesma técnica já usada em activateHelper()).
    match /emergency_pings/{emergencyId} {
      allow read: if isAuthenticated();
      allow write: if false; // só a Cloud Function (Admin SDK) escreve aqui
    }

    // Health professionals collection (usado pelo app KMM)
    // Somente leitura para o cliente. O documento é criado pela Function createCheckoutSession
    // e plano, validade e verificação só mudam via Admin SDK (webhook do Stripe, cron de
    // expiração, scripts administrativos).
    match /health_professionals/{professionalId} {
      allow read: if isAuthenticated();
      allow create: if false;
      // O dono pode editar apenas campos de perfil de contato — lista permitida (nunca lista de bloqueio).
      allow update: if isAuthenticated() && isOwner(professionalId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['bio', 'phone', 'whatsapp', 'clinicAddress', 'profilePhoto']);
      allow delete: if false;
    }

    // Identificadores de billing do Stripe (stripeCustomerId/stripeSubscriptionId) — separados
    // de health_professionals (que qualquer autenticado lê) porque não precisam estar públicos.
    // Só a Cloud Function (Admin SDK) acessa; já cairia no default-deny do fim do arquivo, mas
    // fica explícito aqui como documentação (achado de auditoria de segurança).
    match /health_professionals_billing/{professionalId} {
      allow read, write: if false;
    }

    // UBS (Health Centers) - read-only for users
    match /ubs/{ubsId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only admin can write via Functions
    }
    
    // Educational content
    match /education/{contentId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only admin can write
    }
    
    // User ratings
    match /ratings/{ratingId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
            || resource.data.reviewedId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }
    
    // Chat messages for emergencies (used by ChatRepositoryImpl via emergency_chats collection)
    match /emergency_chats/{emergencyId}/messages/{messageId} {
      // Apenas os participantes da emergência podem ler as mensagens
      allow read: if isAuthenticated()
        && (request.auth.uid == get(/databases/$(database)/documents/emergency_requests/$(emergencyId)).data.requesterId
            || request.auth.uid == get(/databases/$(database)/documents/emergency_requests/$(emergencyId)).data.helperId);
      // Sender must be authenticated AND the actual author AND a participant.
      // The "system" senderId bypass was removed: system messages must be written
      // via Admin SDK (Cloud Functions) which bypasses rules entirely.
      allow create: if isAuthenticated()
        && request.resource.data.senderId == request.auth.uid
        && (request.auth.uid == get(/databases/$(database)/documents/emergency_requests/$(emergencyId)).data.requesterId
            || request.auth.uid == get(/databases/$(database)/documents/emergency_requests/$(emergencyId)).data.helperId)
        && isValidString(request.resource.data.message, 1, 1000);
      allow update, delete: if false;
    }

    // Leads collection (website interest forms)
    match /leads/{leadId} {
      allow create: if isAuthenticated()
        && isValidString(request.resource.data.name, 2, 200)
        && isValidString(request.resource.data.email, 5, 100)
        && isValidString(request.resource.data.plan, 1, 200)
        && request.resource.data.type in ['medico', 'clinica'];
      allow read, update, delete: if false;
    }

    // Check-ins da Agenda de Saúde — cada usuário lê/escreve apenas os seus
    match /checkins/{userId}/responses/{responseId} {
      allow read, write: if isOwner(userId);
    }

    // Perfil médico — dados clínicos sensíveis, apenas o próprio usuário
    match /medical_profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Medicações — vinculadas ao userId no documento
    match /medications/{medicationId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      // userId não pode ser alterado — previne transferência de registro entre usuários
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // Contatos de emergência médica
    match /emergency_contacts/{contactId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // Exames médicos
    match /medical_exams/{examId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // Notificações — escritas pelo app client (idealmente migrar para Cloud Function)
    match /notifications/{notificationId} {
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'type', 'timestamp', 'data'])
        && request.resource.data.type is string
        && request.resource.data.timestamp is number;
      allow read, update, delete: if false;
    }

    // NPS responses
    match /nps_responses/{responseId} {
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Reviews de emergência
    match /reviews/{reviewId} {
      allow create: if isAuthenticated()
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow read: if isAuthenticated()
        && (resource.data.reviewerId == request.auth.uid
            || resource.data.reviewedId == request.auth.uid);
      allow update, delete: if false;
    }

    // User statistics — written exclusively by Cloud Functions (Admin SDK).
    // Client only reads its own document to display weekly emergency count.
    match /user_stats/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // Only Cloud Functions (Admin SDK) can write
    }

    // Risk score snapshots — written by app (one per user per day), read by owner only
    match /risk_scores/{userId}/snapshots/{date} {
      allow read, write: if isOwner(userId);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
